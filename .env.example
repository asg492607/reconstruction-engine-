# Reality Reconstruction Engine (RRE) - Environment Configuration
APP_NAME="Reality Reconstruction Engine"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="rre_insecure_development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (supports sqlite+aiosqlite:///./rre.db or postgresql+asyncpg://user:pass@localhost:5432/rre)
DATABASE_URL="sqlite+aiosqlite:///./data/rre.db"

# Storage Configuration (MINIO or LOCAL)
STORAGE_BACKEND="LOCAL"
LOCAL_STORAGE_DIR="./storage"

# MinIO (when STORAGE_BACKEND="MINIO")
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="rre-evidence"
MINIO_SECURE=False

# LLM Configuration
GEMINI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
